MONGO_URI="mongodb://localhost:27017/Vib&Temp"
TGW_IP=192.168.1.100
TGW_PORT=502
SLAVE_ID=1
POLL_MS=5000

# Modbus addressing: iSN-713 docs typically use Base-0 for Input (3xxxx)
IS_BASE0=true

# Scaling (adjust when you confirm your firmware/units)
SCALE_ACCEL=1       # mg multiplier (if your device returns mg directly, keep 1)
SCALE_VELOCITY=1    # velocity multiplier (mm/s or µm/s depending on FW)
SCALE_CREST=0.01    # crest factor often reported with 0.01 scale in quick start

# Equipment configuration
EQUIPMENT_ID=PUMP-003
LOCATION="Machine Room A - Pump #3"
ALERT_RECIPIENT=alltechnify@gmail.com

# Alert thresholds (mm/s)
WARNING_MIN=100
WARNING_MAX=200
CRITICAL_MIN=200

# Alert cooldown in milliseconds (5 minutes)
ALERT_COOLDOWN_MS=300000